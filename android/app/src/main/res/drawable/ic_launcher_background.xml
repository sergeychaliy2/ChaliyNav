<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background: deep forest. Solid colour keeps AAPT2 happy
     on all OEM launchers (some mask adaptive icons aggressively). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 Z"
          android:fillColor="#14261E"/>

    <!-- Subtle outer glow ring (kept inside safe zone so launchers don't clip it) -->
    <path
        android:pathData="M54,54 m-36,0 a36,36 0 1,0 72,0 a36,36 0 1,0 -72,0 Z"
        android:strokeColor="#1B6B3A"
        android:strokeWidth="1.2"
        android:fillColor="#1B6B3A"
        android:fillAlpha="0.35"/>

    <!-- Inner glow ring -->
    <path
        android:pathData="M54,54 m-28,0 a28,28 0 1,0 56,0 a28,28 0 1,0 -56,0 Z"
        android:strokeColor="#4ADE80"
        android:strokeWidth="0.8"
        android:fillColor="#00000000"
        android:strokeAlpha="0.35"/>
</vector>
